VITE_DEMO_MODE=true

# --- Gemini API (server-side only — never prefix with VITE_) ---
# Required for real charm concept generation (api/generate-charm-concept.js,
# api/generate-image.js). Without it, both endpoints return 501 and the app
# falls back to clearly-labeled demo concepts.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Preview deployment gate (server-side only — never prefix with VITE_) ---
# When set, api/generate-charm-concept.js and api/generate-image.js require a
# matching X-Preview-Access header or respond 401 before the Gemini key is
# ever read — see src/lib/previewAccess.ts for the client-side prompt that
# collects this from whoever has the preview link and attaches it. Leave
# unset on Production (an unset value is a no-op, not an open gate).
PREVIEW_ACCESS_TOKEN=

# --- Supabase (not yet wired up — see supabase/schema.sql) ---
# The app currently runs on the localStorage demo adapter in
# src/services/storage.ts. These are documented for the future real backend;
# setting them alone does nothing until that adapter is built.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only — never prefix with VITE_
